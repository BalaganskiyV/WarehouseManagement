{
  "Database": {
    "Provider": "SqlServer",
    "ApplyMigrations": false
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=WarehouseManagementRevised;Trusted_Connection=True;MultipleActiveResultSets=true",
    "Sqlite": "Data Source=warehouse-dev.db"
  },
  "JwtSettings": {
    "Issuer": "WarehouseManagement",
    "Audience": "WarehouseManagement.Client",
    "ExpirationMinutes": 60
  },
  "Generator": {
    "Enabled": false,
    "IntervalSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
